generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model Investor {
  id  Int @id @default(autoincrement())
  name String
  type String
  avatarUrl String?
  websiteUrl String?
  investments Investment[]

  favoritedBy FavoriteInvestor[]
}

model Company {
  id Int @id @default(autoincrement())
  name String
  description String?
  sectors CompanySector[]
  investments Investment[]
  logoUrl String?
  websiteUrl String?
  location String?
  }

model Sector {
  id Int @id @default(autoincrement())
  name String @unique
  companies CompanySector[]
}

model CompanySector {
  id Int @id @default(autoincrement())
  companyId Int
  sectorId Int
  company Company @relation(fields: [companyId], references: [id])
  sector Sector @relation(fields: [sectorId], references: [id])
}

model Investment {
  id Int @id @default(autoincrement())
  investorId Int
  companyId Int
  amount Float?
  stage String?
  investedAt DateTime?
  investor Investor @relation(fields: [investorId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([investorId])
  @@index([companyId])
}

enum Plan {
  FREE
  PREMIUM
  ULTIMATE
}

enum BuilderType {
  SOLO
  COLLABORATIVE
}

enum ProjectStage {
  IDEATION
  MVP
  VALIDATION
  RAISING_FUNDS
}

model User {
  id String @id @default(cuid())
  clerkUserId String @unique

  plan               Plan     @default(FREE)
  onboardingComplete Boolean  @default(false)

  builderType BuilderType?
  stage ProjectStage?
  industries String[] @default([])
  goals String[] @default([])

  favoriteInvestors FavoriteInvestor[]

  oneLiners         OneLinerHistory?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model FavoriteInvestor {
  userId String
  investorId Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@id([userId, investorId])

  createdAt DateTime @default(now())
}

model OneLinerHistory {
  id String @id @default(cuid())

  userId String @unique
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  interactions OneLinerInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OneLinerInteraction {
  id String @id @default(cuid())

  historyId String
  history OneLinerHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  submission OneLinerSubmission?

  response Json

  createdAt DateTime @default(now())
}

model OneLinerSubmission {
  id String @id @default(cuid())

  interactionId String @unique
  interaction OneLinerInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  target OneLinerTarget
  industry String
  name String
  explanation String
  user String
  problem String
  result String
  unique String

  createdAt DateTime @default(now())
}

enum OneLinerTarget {
  Businesses
  Consumers
  Both
}

model RateLimit {
  id    String    @id @default(cuid())
  key   String
  action    String
  count     Int   @default(1)
  resetAt   DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([key, action])
}