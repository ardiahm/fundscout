generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model Investor {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  type        String
  avatarUrl   String?
  websiteUrl  String?
  investments Investment[]

  favoritedBy FavoriteInvestor[]
}

model Company {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  sectors     CompanySector[]
  investments Investment[]
  logoUrl     String?
  websiteUrl  String?
  location    String?
}

model Sector {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  companies CompanySector[]
}

model CompanySector {
  id        Int     @id @default(autoincrement())
  companyId Int
  sectorId  Int
  company   Company @relation(fields: [companyId], references: [id])
  sector    Sector  @relation(fields: [sectorId], references: [id])

  @@unique([companyId, sectorId])
}

model Investment {
  id         Int       @id @default(autoincrement())
  investorId Int
  companyId  Int
  amount     Float?
  stage      String?
  investedAt DateTime?
  investor   Investor  @relation(fields: [investorId], references: [id])
  company    Company   @relation(fields: [companyId], references: [id])

  @@index([investorId])
  @@index([companyId])
}

enum Plan {
  FREE
  PREMIUM
  ULTIMATE
}

enum BuilderType {
  SOLO
  COLLABORATIVE
}

enum ProjectStage {
  IDEATION
  MVP
  VALIDATION
  RAISING_FUNDS
}

model User {
  id          String @id @default(cuid())
  clerkUserId String @unique

  plan               Plan    @default(FREE)
  onboardingComplete Boolean @default(false)

  builderType BuilderType?
  stage       ProjectStage?
  industries  String[]      @default([])
  goals       String[]      @default([])

  favoriteInvestors FavoriteInvestor[]

  oneLiners OneLinerHistory?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  outreachHistory OutreachHistory?
  valuationHistory ValuationHistory?
}

model FavoriteInvestor {
  userId     String
  investorId Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, investorId])
}

model OneLinerHistory {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  interactions OneLinerInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OneLinerInteraction {
  id String @id @default(cuid())

  historyId String
  history   OneLinerHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  submission OneLinerSubmission?

  response Json

  createdAt DateTime @default(now())
}

model OneLinerSubmission {
  id String @id @default(cuid())

  interactionId String              @unique
  interaction   OneLinerInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  target      OneLinerTarget
  industry    String
  name        String
  explanation String
  user        String
  problem     String
  result      String
  unique      String

  createdAt DateTime @default(now())
}

enum OneLinerTarget {
  Businesses
  Consumers
  Both
}

model OutreachHistory {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  interactions OutreachInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OutreachInteraction {
  id String @id @default(cuid())

  historyId String
  history   OutreachHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  submission OutreachSubmission?

  response Json

  createdAt DateTime @default(now())
}

model OutreachSubmission {
  id String @id @default(cuid())

  interactionId String              @unique
  interaction   OutreachInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  // free text, so one form works for any kind of recipient
  sender    String
  recipient String
  reason    String

  ask    OutreachAsk
  method OutreachMethod
  tone   OutreachTone
  length OutreachLength
}

enum OutreachAsk {
  BOOK_A_CALL
  GET_ADVICE
  GET_FEEDBACK
  AN_INTRODUCTION
  GET_A_REPLY
  OTHER
}

enum OutreachMethod {
  EMAIL
  MESSAGE_LINKEDIN_MOBILE
}

enum OutreachTone {
  PROFESSIONAL
  FRIENDLY
  CASUAL
  DIRECT
}

enum OutreachLength {
  SHORT
  MEDIUM
  DETAILED
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String
  action    String
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, action])
}

model ValuationHistory {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  interactions ValuationInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ValuationInteraction {
  id String @id @default(cuid())

  historyId String
  history   ValuationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  submission ValuationSubmission?

  // computed range, methods, comparables and the optional write-up
  response Json

  createdAt DateTime @default(now())
}

model ValuationSubmission {
  id String @id @default(cuid())

  interactionId String               @unique
  interaction   ValuationInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  companyName String?
  stage       ValuationStage
  sector      String
  raiseAmount Float

  // only filled in when the startup has revenue
  hasRevenue     Boolean
  monthlyRevenue Float?
  monthlyGrowth  Float?
  grossMargin    Float?

  // 1-5 self ratings
  teamRating        Int
  marketRating      Int
  productRating     Int
  competitionRating Int
  tractionRating    Int
}

enum ValuationStage {
  PRE_SEED
  SEED
  SERIES_A
  SERIES_B
}
